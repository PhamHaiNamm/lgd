            <th style="width: 25%;">Họ và tên</th>
            <th style="width: 22%;">Tên đăng nhập (Username)</th>
            <th style="width: 20%;">Mật khẩu</th>
            <th style="width: 25%;">Chức vụ / Quyền</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td style="text-align: center;">1</td>
            <td><strong>Hải Nam</strong></td>
            <td><code>hainam</code></td>
            <td><span class="password-box">123</span></td>
            <td><span class="role-admin">👑 Admin (Trưởng đoàn)</span></td>
        </tr>
        <tr>
            <td style="text-align: center;">2</td>
            <td><strong>Quản Trị Viên Hệ Thống</strong></td>
            <td><code>admin</code></td>
            <td><span class="password-box">adminPassword123</span></td>
            <td><span class="role-admin">👑 Admin Hệ thống</span></td>
        </tr>
    </tbody>
</table>

